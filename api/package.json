{
  "name": "@zindex/api",
  "version": "0.1.0",
  "private": true,
  "description": "Zindex API: accounts, stores, invoices, stock and delivery cards (Express + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "dev:db": "tsx scripts/dev-db.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed-dev.ts",
    "load": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
