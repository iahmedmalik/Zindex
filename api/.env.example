# Copy to api/.env.local. The values below point at the local development database
# (`npm run dev:db -w @zindex/api`). For production, the real values go only in
# Render's environment settings, never in a file in the repo.

DATABASE_URL_APP=postgres://zx_app:zx_app_local@127.0.0.1:5434/zindex

# Sign-in: a long random string (for example `openssl rand -hex 32`)
BETTER_AUTH_SECRET=dev-only-secret-change-me-dev-only-secret-change-me

# Where the web app runs, and where this API is reachable from outside
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Only for `npm run db:migrate -w @zindex/api`: the table owner's connection string.
DATABASE_URL_OWNER=postgres://postgres:owner_local@127.0.0.1:5434/zindex

# Email (verification, password reset). Leave BREVO_API_KEY blank in development: the link is
# printed in the server log instead. The key goes only in Render's settings.
# BREVO_API_KEY=
# MAIL_FROM=Zindex <no-reply@example.com>

# Shopify product sync (optional). One Dev Dashboard app per shop, read_products scope only.
# The keys go only in Render's settings, as one line of JSON:
# SHOPIFY_APPS={"sheen-perfumes.myshopify.com":{"clientId":"...","clientSecret":"..."}}
